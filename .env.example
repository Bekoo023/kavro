# Kopieer naar .env.local (lokaal) of zet deze bij je hostingpartij. Nooit committen.

# Publieke URL, gebruikt voor metadataBase (og:image, canonical), sitemap en robots.
# Leeg = fallback naar https://kavrov.vercel.app. Lokaal eventueel http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://kavrov.vercel.app

# --- Beheer (/beheer) ---
# Minimaal 12 tekens
ADMIN_PASSWORD=
# Minimaal 32 willekeurige tekens, bijv: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# --- Opslag ---
# Productie: Postgres (Neon, Supabase, Vercel Postgres ...). Tabellen worden automatisch aangemaakt.
DATABASE_URL=
# Alternatief op een eigen server met blijvende schijf (niet op Vercel):
# STORAGE_DRIVER=file
# DATA_DIR=/var/lib/studio-data

# --- E-mailmelding bij nieuwe aanvraag (optioneel, via Resend) ---
RESEND_API_KEY=
MAIL_FROM="Studio <aanvragen@jouwdomein.nl>"
MAIL_TO=jij@jouwdomein.nl
